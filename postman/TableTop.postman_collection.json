{
  "info": {
    "name": "TableTop API",
    "description": "Запустите приложение (mvn spring-boot:run). Сначала Register или Login: токен сохранится в переменную коллекции сам. Create recipe сохраняет recipeId и recipeVersion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": "me@example.com"
    },
    {
      "key": "password",
      "value": "secret123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "recipeId",
      "value": ""
    },
    {
      "key": "recipeVersion",
      "value": "0"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "201 и токен. Если email уже занят — 409, тогда используйте Login.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"displayName\": \"Sonia\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) { pm.collectionVariables.set('token', json.accessToken); }",
                  "pm.test('token received', () => pm.expect(json.accessToken).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) { pm.collectionVariables.set('token', json.accessToken); }",
                  "pm.test('token received', () => pm.expect(json.accessToken).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Recipes",
      "item": [
        {
          "name": "Create recipe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recipes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recipes"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Классическая мясная лазанья\",\n  \"servings\": 4,\n  \"totalTimeMin\": 90,\n  \"sourceUrl\": \"https://example.com/lasagna\",\n  \"ingredients\": [\n    \"500 г фарша\",\n    \"1 1/2 ч. л. соли\",\n    \"2 яйца\",\n    \"2-3 зубчика чеснока\",\n    \"соль по вкусу\"\n  ],\n  \"steps\": [\n    \"Обжарить фарш\",\n    \"Собрать слои\",\n    \"Запечь 40 минут\"\n  ],\n  \"tags\": [\n    \"Italian\",\n    \"Dinner\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('recipeId', json.id); pm.collectionVariables.set('recipeVersion', json.version); }",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get recipe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recipes/{{recipeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recipes",
                "{{recipeId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('recipeId', json.id); pm.collectionVariables.set('recipeVersion', json.version); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get recipe scaled to 2 servings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recipes/{{recipeId}}?servings=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recipes",
                "{{recipeId}}"
              ],
              "query": [
                {
                  "key": "servings",
                  "value": "2"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Update recipe",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recipes/{{recipeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recipes",
                "{{recipeId}}"
              ]
            },
            "description": "Отправьте дважды: второй раз со старой версией будет 409, если перед этим не обновить recipeVersion.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Лазанья с бешамелем\",\n  \"servings\": 4,\n  \"totalTimeMin\": 90,\n  \"sourceUrl\": \"https://example.com/lasagna\",\n  \"ingredients\": [\n    \"700 г фарша\",\n    \"1 л молока\",\n    \"50 г сливочного масла\"\n  ],\n  \"steps\": [\n    \"Обжарить фарш\",\n    \"Собрать слои\",\n    \"Запечь 40 минут\"\n  ],\n  \"tags\": [\n    \"Italian\",\n    \"Dinner\"\n  ],\n  \"version\": {{recipeVersion}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('recipeId', json.id); pm.collectionVariables.set('recipeVersion', json.version); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Favorite",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recipes/{{recipeId}}/favorite",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recipes",
                "{{recipeId}}",
                "favorite"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"favorite\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete (to trash)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recipes/{{recipeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recipes",
                "{{recipeId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Restore",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recipes/{{recipeId}}/restore",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recipes",
                "{{recipeId}}",
                "restore"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Invalid recipe (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recipes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recipes"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"  \",\n  \"servings\": 0,\n  \"sourceUrl\": \"ftp://x\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}